# DBV PDF2Deck - Variables de entorno (backend)
# Copia este archivo como .env en la raíz del proyecto o dentro de backend/
# y ajusta valores según la capacidad de tu equipo.

# Tamaño máximo de subida (MB)
DBV_MAX_UPLOAD_MB=20

# Límite máximo por lado (px) para imagen/página renderizada
DBV_MAX_IMAGE_SIDE_PX=8000

# Límite máximo de píxeles totales por imagen/página
DBV_MAX_IMAGE_TOTAL_PIXELS=25000000
